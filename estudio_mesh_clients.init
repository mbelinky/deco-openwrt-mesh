#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT
# Optional RAM service; no boot enablement or live controller delivery.
USE_PROCD=1
START=96
STOP=10
start_service() {
    procd_open_instance collector
    procd_set_param command /bin/sh /tmp/estudio_mesh_clients.sh
    procd_set_param respawn 3600 2 5
    procd_set_param term_timeout 10
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
