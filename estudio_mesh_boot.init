#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT
USE_PROCD=1
START=98
STOP=7

start_service() {
    test "$(cat /sys/class/net/eth0/address)" = 02:00:00:00:00:19 || return 1
    ucode -e 'import { storage_ok } from "/etc/estudio-boot/storage.uc"; if (!storage_ok()) exit(9);' || return 1
    procd_open_instance prepare
    procd_set_param command /bin/sh /etc/estudio-boot/start.sh
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
