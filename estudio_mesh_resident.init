#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT
# An explicit RAM session. The session restores the baseline on normal stop
# or runtime failure; it does not restart a failed configuration transaction.
USE_PROCD=1
START=97
STOP=8
start_service() {
    test "$(cat /sys/class/net/eth0/address)" = 02:00:00:00:00:19 || return 1
    ucode -e 'import { storage_ok } from "/tmp/estudio_mesh_storage.uc"; if (!storage_ok()) exit(9);' || return 1
    test -f /tmp/estudio-mesh-resident/run.sh || return 1
    test ! -e /tmp/estudio-mesh-resident/control/stop || return 1
    procd_open_instance node
    procd_set_param command /bin/sh /tmp/estudio-mesh-resident/run.sh
    procd_set_param term_timeout 150
    procd_close_instance
}
stop_service() {
    test ! -d /tmp/estudio-mesh-resident/control || touch /tmp/estudio-mesh-resident/control/stop
    # Let the configuration worker finish and the nested owners restore in
    # order before rc.common requests process termination.
    for attempt in $(seq 1 140); do
        pid=$(ubus call service list '{"name":"estudio_mesh_resident"}' | jsonfilter -e '@.estudio_mesh_resident.instances.node.pid')
        test -n "$pid" && kill -0 "$pid" 2>/dev/null || return 0
        sleep 1
    done
    return 1
}
