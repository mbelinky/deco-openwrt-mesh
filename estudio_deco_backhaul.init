#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT
# RAM-only until complete mesh integration and recovery have been validated.
USE_PROCD=1
START=95
STOP=10
start_service() {
    procd_open_instance adapter
    procd_set_param command /bin/sh /tmp/estudio_deco_backhaul.sh
    procd_set_param respawn 3600 1 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
