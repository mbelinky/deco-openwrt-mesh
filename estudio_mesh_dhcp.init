#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT
# Native lease ownership for the isolated mesh-management namespace.
USE_PROCD=1
START=96
STOP=9
start_service() {
    test "$(cat /sys/class/net/eth0/address)" = 02:00:00:00:00:19 || return 1
    ucode -e 'import { storage_ok } from "/tmp/estudio_mesh_storage.uc"; if (!storage_ok()) exit(9);' || return 1
    test -e /var/run/netns/codex-sixbh-client || return 1
    test "$(ip -n codex-sixbh-client -o link show dev br-lan | awk '{for(i=1;i<=NF;i++) if($i=="link/ether") print $(i+1)}')" = 02:00:00:00:00:0c || return 1
    mkdir -p /tmp/estudio-mesh-dhcp
    chmod 700 /tmp/estudio-mesh-dhcp
    procd_open_instance lease
    procd_set_param command /sbin/ip netns exec codex-sixbh-client /sbin/udhcpc \
        -f -i br-lan -p /tmp/estudio-mesh-dhcp/client.pid \
        -s /tmp/estudio_mesh_dhcp.uc -t 4 -T 3 -A 5
    procd_set_param respawn 3600 2 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
